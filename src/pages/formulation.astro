---
import { getEntry, render } from "astro:content";

import Base from "../layouts/Base.astro";

const entry = await getEntry("docs", "formulation");
if (!entry) throw new Error("docs/formulation.md is missing");
const { Content } = await render(entry);
---

<Base
  title="Formulation Doctrine"
  path="/formulation/"
  description="The house blends, the levers, and their rails."
>
  <article class="doc">
    <Content />
  </article>
</Base>
