---
import { getEntry, render } from "astro:content";

import Base from "../layouts/Base.astro";

const entry = await getEntry("docs", "method");
if (!entry) throw new Error("docs/method.md is missing");
const { Content } = await render(entry);
---

<Base title="House Method" path="/method/" description="The current cold-process method.">
  <article class="doc">
    <Content />
  </article>
</Base>
